{
	"main": "dist/_worker.js/index.js",
	"name": "blog-andodaryl-com",
  	"compatibility_date": "2026-02-20",
  	"compatibility_flags": [
    		"nodejs_compat",
    		"disable_nodejs_process_v2"
  	],
	  "routes": [{
		"pattern": "blog.andodaryl.com",
      		"zone_name": "blog.andodaryl.com",
      		"custom_domain": true
    	}],
  	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
  	},
  	"observability": {
    		"enabled": true
  	}
}

{
	"main": "dist/_worker.js/index.js",
	"name": "blog-andodaryl-com",
  	"compatibility_date": "2026-02-20",
	"build": {
		"command": "pnpm install && pnpm astro add cloudflare --yes && npx astro build"	
	},
	"routes": [{
		"pattern": "blog.andodaryl.com",
      		"custom_domain": true
    	}],
  	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
  	},
}

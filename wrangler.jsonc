{
	"main": "dist/_worker.js/index.js",
	"name": "blog.andodaryl.com",
  "compatibility_date": "2026-02-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "route": {
    "zone_name": "blog.andodaryl.com"
  },
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  }
}
